# ============================================================
# MediLens - Environment Configuration Template
# ============================================================
# Copy this file to ".env" and fill in your own values:
#   cp .env.example .env
#
# The app runs with sensible defaults even without a .env file,
# EXCEPT for whichever LLM provider you choose to use - that
# provider's API key is required for AI features to work.
# ============================================================

# --- App Settings ---
DEBUG=True

# --- Security ---
# IMPORTANT: Generate a real random secret for production, e.g. with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-in-production

# --- Choose your AI provider: gemini | claude | openai | ollama ---
LLM_PROVIDER=gemini

# --- Only fill in the key for whichever provider you chose above ---
GEMINI_API_KEY=Your Gemini Key
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Ollama (only needed if LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
